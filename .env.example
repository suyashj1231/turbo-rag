# copy to .env and fill in (never commit .env)
# free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=...
# optional: hosted reranker (free trial key at dashboard.cohere.com); without it a local cross-encoder is used
COHERE_API_KEY=
# optional overrides — free-tier quotas are per model per day
# RAG_LLM_MODEL=gemini-2.5-flash
# RAG_JUDGE_MODEL=gemini-3.6-flash
